# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Data Paths
DATA_PATH=./data
MODELS_PATH=./models
REPORTS_PATH=./reports

# Recommendation Engine
MIN_SCORE_THRESHOLD=0.5
TOP_K_RECOMMENDATIONS=5

# Evaluation
HOLD_OUT_TEST_SIZE=0.2
RANDOM_SEED=42

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# CORS
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*
